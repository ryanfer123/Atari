+    /** ADB-accessible smoke path used by ATARI's physical-device benchmark script. */
+    private suspend fun runAutomatedInference(prompt: String) {
+        val output = StringBuilder()
+        val startedAt = SystemClock.elapsedRealtime()
+        Log.i(TAG, "$AUTOMATION_STARTED promptChars=${prompt.length}")
+        try {
+            engine.sendUserPrompt(prompt).collect { token -> output.append(token) }
+            val elapsedMs = SystemClock.elapsedRealtime() - startedAt
+            Log.i(
+                TAG,
+                "$AUTOMATION_COMPLETE elapsedMs=$elapsedMs output=${output.toString().replace('\n', ' ')}"
+            )
+        } catch (error: Exception) {
+            Log.e(TAG, "$AUTOMATION_ERROR generation_failed", error)
+        }
+    }
